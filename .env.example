SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
DATABASE_URL=sqlite:///db.sqlite3
BACKUP_DIR=./backups
RUN_SCHEDULER=0

# Logging. INFO er default. Sett DEBUG midlertidig ved feilsøking i prod —
# variabelen leses ved oppstart, så det krever restart, ikke deploy.
LOG_LEVEL=INFO

# E-postvarsel ved uhåndterte feil (F1). Uten EMAIL_HOST skrives varselet til
# konsollen i stedet for å sendes — alt under er derfor valgfritt lokalt.
#
# PROD BRUKER HTTP-API-ET, IKKE SMTP. Railway sperrer utgående SMTP — målt fra
# containeren 22. aug. 2026 er portene 587, 2525, 465 og 25 alle stengt, mens
# 443 mot samme vert er åpen. SMTP-variablene under er derfor kun til lokal
# bruk og offline-modus. Se core/mail_backends.py.
#
# AHASEND_API_KEY=aha-sk-<64 tegn>      scope: messages:send:mail.sanitet.net
# AHASEND_ACCOUNT_ID=<konto-id fra AHASend-dashbordet>
#
# Tidsgrense for utsending. Må aldri være None: AdminEmailHandler sender
# synkront i requestens egen tråd, og en hengende vert ville låst den.
# EMAIL_TIMEOUT=10
#
# Prod bruker AHASend, med mail.sanitet.net som avsenderdomene. Verdiene under
# er formateksempler; de faktiske står som Railway-variabler.
#
# DEFAULT_FROM_EMAIL må ligge på et domene leverandøren er autorisert til å
# sende fra, ellers avvises varselet ved innsending — og da får du aldri vite
# at noe kræsjet. SERVER_EMAIL arver fra denne, se settings.py.
#
# Verifiser oppsettet med:  python manage.py sendtestemail --admins
#
# ADMINS er komma-separert, med formatet Navn:epost
# ADMINS=André:andre.eritsland@gmail.com
# EMAIL_HOST=<smtp-vert fra AHASend>
# EMAIL_PORT=587
# EMAIL_HOST_USER=<smtp-brukernavn fra AHASend>
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=sanitetsportalen@mail.sanitet.net
